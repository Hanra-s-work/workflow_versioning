# Let's redecorate this place (Colours)
RESET_COL="\033[0m"
RESET_BOLD="\033[0m"

BOLD="\033[1m"
RED_COL="\033[38;5;9m"
CYAN_COL="\033[38;5;51m"
GREEN_COL="\033[38;5;46m"
YELLOW_COL="\033[38;5;226m"

# Booleans
TRUE=0
FALSE=1
YES=$TRUE
NO=$FALSE

# Did it work? (Status output)
OK="[${GREEN_COL}OK${RESET_COL}]"
KO="[${RED_COL}KO${RESET_COL}]"

# Where are we ? (Path handling)
ORIG_PWD="$(pwd)"

# What's the date today? (Current date)
DATE_TAG="$(date +'%Y_%m_%d')"
DATE_TAG_PRECISE="$(date +'%Y_%m_%d_%H%M%S')"

# Where's my room ? (Log handling)
GOURCE_LOG="/tmp/gource"
GOURCE_LOG_FILE="$GOURCE_LOG/gource_log_${DATE_TAG}.log"
GOURCE_STANDARD_OUT="$GOURCE_LOG/gource_stdout_${DATE_TAG}.stdout.log"
GOURCE_STANDARD_ERR="$GOURCE_LOG/gource_stderr_${DATE_TAG}.stderr.log"
FFMPEG_STANDARD_OUT="$GOURCE_LOG/ffmpeg_stdout_${DATE_TAG}.stdout.log"
FFMPEG_STANDARD_ERR="$GOURCE_LOG/ffmpeg_stderr_${DATE_TAG}.stderr.log"

# Where's Gource ? (Gource path handling)
# Path to your Windows Gource folder (ASCII-only path!)
GOURCE_DIR="$(pwd)"
GOURCE_BIN_NAME="gource.exe"

# Who's the patient ? (Use current directory as repo if not specified)
REPO_DIR="."

# What's the size ? (Gource Screen resolution)
SCREEN_RESOLUTION="720x480"
SCREEN_RESOLUTION_ALTERED=$FALSE

# Where's the doctor ? (WINE_BINARY)
WINE_BIN=$(command -v "wine" || echo "")

# Where's the patient ? (Gource binary)
GOURCE_BIN=$(command -v "$GOURCE_DIR/$GOURCE_BIN_NAME" || echo "")

# What's his name ? (Wine desktop mode)
WINE_DESKTOP_ENABLED=$FALSE
WINE_DESKTOP_NAME="Gource"
WINE_DESKTOP_SIZE=""

# Where's the camera ? (Video settings)
VIDEO_MODE=$FALSE
GOURCE_PPM_OUTPUT="$GOURCE_LOG/gource_output_${DATE_TAG_PRECISE}.ppm"
GOURCE_VIDEO_OUTPUT_FILE="$GOURCE_LOG/gource_output_${DATE_TAG_PRECISE}.mp4"
VIDEO_FILE="$GOURCE_VIDEO_OUTPUT_FILE"
GOURCE_VIDEO_ARGS=()

# What's the patient's name ? (Project name)
DEFAULT_PROJECT_NAME="Sample"

# Where's the translator ? (FFMPEG settings)
FFMPEG_BIN=$(command -v "ffmpeg" || echo "")
FFMPEG_ARGS=()

# What are the doctor's instructions ?
# Flags that are to be passed to gource for stability reasons (or other functionality tweaking)
GOURCE_FLAGS=()
REDIRECT_FLAGS=()

# How long is a gource day ? (Seconds per day in gource)
SECONDS_PER_DAY=""
SECONDS_PER_DAY_ALTERED=$FALSE

# What's the version ? (Program version)
VERSION="1.0.0"

# Who...are...you...? (Program author)
AUTHOR="Henry Letellier"

# Is it dry January? (Is it a test run)
DRY_RUN=$FALSE

# Help section

function disclaimer {
    printf "%bDisclaimer:%b\n" "$BOLD" "$RESET_BOLD"
    printf "  This program/script is provided as-is, with NO WARRANTY. Use at your own risk. %b\n\n" "$KO"
}

function show_help {
    printf "\n%b Gource Helper%b\n" "$BOLD" "$RESET_BOLD"
    printf "%bUsage:%b %b [options] [video_file]\n" "$CYAN_COL" "$RESET_COL" "$0"
    printf "\n%bOptions:%b\n" "$BOLD" "$RESET_BOLD"
    printf "  %b--help%b                   Show this help message and exit.\n" "$YELLOW_COL" "$RESET_COL"
    printf "  %b--video%b [file]           Generate a video instead of live rendering. Optional [file] specifies the output mp4 filename.\n" "$GREEN_COL" "$RESET_COL"
    printf "  %b--author%b                 Display the name of this program's author\n" "$GREEN_COL" "$RESET_COL"
    printf "  %b--dry-run%b                Run the script without altering the system (other than generating log files), this can be used to check system requirements and arguments\n" "$GREEN_COL" "$RESET_COL"
    printf "  %b--version%b                Display the current version of the program\n" "$GREEN_COL" "$RESET_COL"
    printf "  %b--resolution%b WxH         Set the resolution of the Gource window. (Default: 480x720). Applies to live and video modes\n" "$GREEN_COL" "$RESET_COL"
    printf "  %b--wine-desktop%b WxH       Set the size of the wine desktop window\n" "$GREEN_COL" "$RESET_COL"
    printf "  %b--seconds-per-day%b N      Control the animation speed.\n" "$GREEN_COL" "$RESET_COL"
    printf "\n%bNotes:%b\n" "$BOLD" "$RESET_BOLD"
    printf "  - By default, Gource will render live in a Wine window.\n"
    printf "  - If %b--video%b is specified, Gource generates a PPM stream, then converts it to MP4 using ffmpeg.\n" "$GREEN_COL" "$RESET_COL"
    printf "  - The script requires a git repository in the current folder.\n"
    printf "  - You can override the project name using the environment variable: %bOVERRIDE_PROJECT_NAME%b\n" "$YELLOW_COL" "$RESET_COL"
    printf "  - You can override the used wine binary by using the environment variable: %bOVERRIDE_WINE_BIN%b\n" "$YELLOW_COL" "$RESET_COL"
    printf "  - You can override the used windows gource binary by using the environment variable: %bOVERRIDE_GOURCE_BIN%b\n" "$YELLOW_COL" "$RESET_COL"
    printf "  - You can override the used ffmpeg binary by using the environment variable: %bOVERRIDE_FFMPEG_BIN%b\n" "$YELLOW_COL" "$RESET_COL"
    printf "  - Output files are stored under: %b%s%b\n" "$CYAN_COL" "$GOURCE_LOG" "$RESET_COL"
    printf "\n%bVersion:%b\n" "$BOLD" "$RESET_BOLD"
    printf "  - %b%s%b\n" "$CYAN_COL" "$VERSION" "$RESET_COL"
    printf "\n%bAuthor:%b\n" "$BOLD" "$RESET_BOLD"
    printf "  Written by %b(c) %s%b\n" "$CYAN_COL" "$AUTHOR" "$RESET_COL"
    disclaimer
    printf "\n%bExamples:%b\n" "$BOLD" "$RESET_BOLD"
    printf "  %b%s%b%b                      Run live Gource in the current repository\n" "$CYAN_COL" "$0" "$GREEN_COL" "$RESET_COL"
    printf "  %b%s %b--video%b              Generate video using default filename\n" "$CYAN_COL" "$0" "$GREEN_COL" "$RESET_COL"
    printf "  %b%s %b--video myvideo.mp4%b  Generate video using custom filename\n" "$CYAN_COL" "$0" "$GREEN_COL" "$RESET_COL"
    printf "  %b%s %b--resolution%b WxH     Set Gource viewport resolution (default: 480x720). Applies to both live and video modes.\n" "$CYAN_COL" "$0" "$GREEN_COL" "$RESET_COL"
    printf "  %b%s %b--seconds-per-day%b N  Control animation speed (e.g. 0.1 = slower).\n" "$CYAN_COL" "$0" "$GREEN_COL" "$RESET_COL"
    printf "\n"
}

function clear_log_file {
    local file_name="$1"
    printf "Clearing file %s..." "$file_name"
    : > "$file_name"
    if [[ "$?" != 0 ]]; then
        printf "%b\n" "$KO"
        printf "Failed to clear file '%s'\n" "$file_name"
        return 1
    fi
    printf "%b\n" "$OK"
}

function run_cmd {
    if [ "$DRY_RUN" == "$TRUE" ]; then
        printf "%b [DRY-RUN]%b " "$YELLOW_COL" "$RESET_COL"
        printf "%q " "$@"
        printf "\n"
        return 0
    fi
    "$@"
    return "$?"
}

function bash_warning {
    local system_name="$(uname -s)"
    local bash_ver_major=${BASH_VERSION%%.*}
    printf "Check if mac..."
    if [[ "$system_name" == "Darwin" ]]; then
        printf "%b\n" "$OK"
        printf "Check if modern bash version..."
        if (( bash_ver_major < 4 )); then
            printf "%b\n" "$KO"
            printf "%bWarning:%b You are running macOS with Bash version %s.\n" "$YELLOW_COL" "$RESET_COL" "$BASH_VERSION"
            printf "Some features (like array appends) require Bash 4+. Consider upgrading Bash via Homebrew:\n"
            printf "  brew install bash\n"
            printf "This script may fail on older macOS default Bash (3.2).\n\n"
        else
            printf "%b\n" "$OK"
        fi
        return 0
    else
        printf "%b\n" "$KO"
    fi
    printf "Check if linux..."
    if [[ "$system_name" == "Linux" ]]; then
        printf "%b\n" "$OK"
        printf "Check if modern bash version..."
        if (( bash_ver_major < 4 )); then
            printf "%b\n" "$KO"
            printf "%bWarning:%b You are running Linux with Bash version %s.\n" "$YELLOW_COL" "$RESET_COL" "$BASH_VERSION"
            printf "Some features (like array appends) require Bash 4+. Consider upgrading Bash via your package manager or manually compiling a newer version from source\n"
            printf "This script may fail on older Linux systems who's default Bash is older than 3.2.\n\n"
        else
            printf "%b\n" "$OK"
        fi
        return 0
    else
        printf "%b\n" "$KO"
    fi
    return 1
}

function gwine_warning {
    printf "%bWine/Gource Notice:%b\n" "$BOLD" "$RESET_BOLD"
    printf "  Tested with:\n"
    printf "    - Gource 0.53 (Windows binary) at path: %s\n" "$GOURCE_DIR/$GOURCE_BIN_NAME"
    printf "      You can override this with OVERRIDE_GOURCE_BIN on call.\n"
    printf "    - Wine 10.0 (system default or OVERRIDE_WINE_BIN)\n"
    printf "  Ensure your binaries match or the script may fail... %b\n\n" "$KO"
}

function user_specs {
    printf "  [%bDetected dynamically on your system%b]\n" "$YELLOW_COL" "$RESET_COL"
    printf "    OS: %s %s\n" "$(lsb_release -ds 2>/dev/null || uname -s)" "$(uname -m)"
    printf "    Desktop: %s\n" "${XDG_SESSION_DESKTOP:-Unknown}"
    printf "    Kernel: %s\n" "$(uname -r)"
}

function tested_specs {
    printf "  [%bTested on my system before shipping%b]\n" "$CYAN_COL" "$RESET_COL"
    printf "    OS: Ubuntu 24.04.3 LTS (64-bit)\n"
    printf "    Desktop: GNOME 46, Wayland\n"
    printf "    Kernel: Linux 6.8.0-94-generic\n\n"
}

function specs {
    printf "%bSystem Specs:%b\n" "$BOLD" "$RESET_BOLD"
    user_specs
    tested_specs
}

printf "Gource for windows (via Wine)\n"
specs
bash_warning
gwine_warning
disclaimer

while [[ $# -gt 0 ]]; do
    case "$1" in
        "--video"|"/video")
            printf "Output video..."
            VIDEO_MODE=$TRUE
            shift
            # Optional second arg = custom path
            if [[ -n "$1" && ! "$1" =~ ^[-/] ]]; then
                VIDEO_FILE="$1"
                shift
            fi
            printf "%b\n" "$OK"
            GOURCE_VIDEO_ARGS+=(--output-ppm-stream -)
            SCREEN_RESOLUTION="1080x720"
            REDIRECT_FLAGS="$GOURCE_PPM_OUTPUT"
            FFMPEG_ARGS+=( -y -r 60 -f image2pipe -vcodec ppm -i "$GOURCE_PPM_OUTPUT" -vcodec libx264 -preset ultrafast -crf 1 -pix_fmt yuv420p -threads 0 -bf 0 "$VIDEO_FILE" )
            printf "Video mode enabled, output file: %s\n" "$VIDEO_FILE"
            ;;
        "--help" | "-help" | "/help" | "--h" | "-h" | "/h" | "--?" | "-?" | "/?")
            printf "Help called...%b\n" "$OK"
            show_help
            exit 0
            ;;
        "--dry-run"|"/dry-run")
            printf "Dry run mode...%b\n" "$OK"
            DRY_RUN=$TRUE
            shift
        ;;
        "--wine-desktop"|"/wine-desktop")
            printf "Wine desktop mode..."
            WINE_DESKTOP_ENABLED=$TRUE
            if [[ -z "$2" || ! "$2" =~ ^[0-9]+x[0-9]+$ ]]; then
                printf "%b\n" "$KO"
                printf "Invalid resolution format: %s (expected WxH)\n" "$2"
                exit 1
            fi
            WINE_DESKTOP_SIZE="$2"
            printf "%b\n" "$OK"
            shift 2
        ;;
        "--resolution"|"/resolution")
            printf "Screen resolution..."
            if [[ -z "$2" || ! "$2" =~ ^[0-9]+x[0-9]+$ ]]; then
                printf "%b\n" "$KO"
                printf "Invalid resolution format: %s (expected WxH)\n" "$2"
                exit 1
            fi
            SCREEN_RESOLUTION="$2"
            SCREEN_RESOLUTION_ALTERED=$TRUE
            shift 2
            printf "%b\n" "$OK"
            printf "Using custom resolution: %s\n" "$SCREEN_RESOLUTION"
        ;;
        "--seconds-per-day"|"/seconds-per-day")
            printf "Seconds per day..."
            if [[ -z "$2" ]]; then
                printf "%b\n" "$KO"
                printf "--seconds-per-day requires a numeric argument (e.g. 0.1)\n"
                exit 1
            fi

            if [[ ! "$2" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                printf "%b\n" "$KO"
                printf "Invalid seconds-per-day value: %s\n" "$2"
                exit 1
            fi

            SECONDS_PER_DAY="$2"
            SECONDS_PER_DAY_ALTERED=$TRUE
            shift 2
            printf "%b\n" "$OK"
            printf "Using seconds-per-day: %s\n" "$SECONDS_PER_DAY"
        ;;
        "--author"|"/author"|"-author")
            printf "Author: %s...%b\n" "$AUTHOR" "$OK"
            exit 0
        ;;
        "--version" | "/version" | "-version" | "--v" | "/v" | "-v" | "--V" | "/V" | "-V")
            printf "Current version: %s...%b\n" "$VERSION" "$OK"
            exit 0
        ;;
        *)
            printf "Alien parameter '%s'...%b\n" "$1" "$KO"
            shift
        ;;
    esac
done

printf "Help called...%b\n" "$KO"
printf "Author called...%b\n" "$KO"
printf "Version called...%b\n" "$KO"
if [[ "$WINE_DESKTOP_ENABLED" == "$FALSE" ]]; then
    printf "Wine desktop mode...%b\n" "$KO"
    printf "Wine desktop mode has not been enabled\n"
fi
if [[ "$VIDEO_MODE" == "$FALSE" ]]; then
    printf "Output video...%b\n" "$KO"
    printf "Video mode disabled, live rendering only\n"
    REDIRECT_FLAGS="$GOURCE_STANDARD_OUT"
fi
if [[ "$SCREEN_RESOLUTION_ALTERED" == "$FALSE" ]]; then
    printf "Screen resolution...%b\n" "$KO"
    printf "The screen resolution has not been altered by any parameters\n"
fi
if [[ "$SECONDS_PER_DAY_ALTERED" == "$FALSE" ]]; then
    printf "Seconds per day...%b\n" "$KO"
    printf "The gource seconds per day has not been altered by any parameters\n"
fi
if [[ "$DRY_RUN" == "$FALSE" ]]; then
    printf "Dry run mode...%b\n" "$KO"
fi

printf "Warming up...\n"
printf "Clearing log files...\n"
GLOBAL_LOG_CHECK=0
clear_log_file "$GOURCE_LOG_FILE"
if [[ "$?" != "0" ]]; then
    GLOBAL_LOG_CHECK=1
fi
clear_log_file "$GOURCE_STANDARD_OUT"
if [[ "$?" != "0" ]]; then
    GLOBAL_LOG_CHECK=1
fi
clear_log_file "$GOURCE_STANDARD_ERR"
if [[ "$?" != "0" ]]; then
    GLOBAL_LOG_CHECK=1
fi
clear_log_file "$FFMPEG_STANDARD_OUT"
if [[ "$?" != "0" ]]; then
    GLOBAL_LOG_CHECK=1
fi
clear_log_file "$FFMPEG_STANDARD_ERR"
if [[ "$?" != "0" ]]; then
    GLOBAL_LOG_CHECK=1
fi
if [[ "$GLOBAL_LOG_CHECK" != "0" ]]; then
    printf "Clearing log files...%b\n" "$KO"
else
    printf "Clearing log files...%b\n" "$OK"
fi
printf "Checking Gource directory..."
if [[ ! -d "$GOURCE_DIR" ]]; then
 printf "%b\n" "$KO"
 printf "Gource directory not found at %s\n" "$GOURCE_DIR"
 exit 1
fi
printf "%b\n" "$OK"
printf "Changing to repository directory..."
cd "$REPO_DIR"
if [[ "$?" != "0" ]]; then
 printf "%b\n" "$KO"
 printf "Could not change to repository directory at %s\n" "$REPO_DIR"
 printf "Reverting to original directory at %s\n" "$ORIG_PWD"
 cd "$ORIG_PWD"
 exit 1
fi
printf "%b\n" "$OK"
printf "Checking if we are in a repository..."
if [[ -d ".git" ]]; then
 printf "%b\n" "$OK"
else
 printf "%b\n" "$KO"
 printf "This script must be run in a repository folder containing a .git folder.\n"
 exit 1
fi
printf "Obtaining repository name..."
if [[ -n "$OVERRIDE_PROJECT_NAME" ]]; then
    PROJECT_NAME="${OVERRIDE_PROJECT_NAME}"
    printf "%b\n" "$OK"
    printf "Override variable set, using it instead of repository name\n"
else
    PROJECT_NAME=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ "$?" != "0" ]]; then
        printf "%b\n" "$KO"
        printf "Failed to gather the repository name, defaulting to $DEFAULT_PROJECT_NAME\n"
        PROJECT_NAME="$DEFAULT_PROJECT_NAME"
    else
        PROJECT_NAME=$(basename "$PROJECT_NAME")
        printf "%b\n" "$OK"
    fi
fi
PROJECT_NAME="$(echo "$PROJECT_NAME" | xargs)"
PROJECT_NAME="$PROJECT_NAME Repository Visualisation"
GOURCE_FLAGS+=("--title" "$PROJECT_NAME")
printf "Making sure gource log folder exists..."
mkdir -p "$GOURCE_LOG"
if [[ "$?" != "0" ]]; then
 printf "%b\n" "$KO"
 printf "Could not create gource log folder at %s\n" "$GOURCE_LOG"
 exit 1
fi
printf "%b\n" "$OK"
printf "Generating gource log..."
git log --reverse --raw --encoding=UTF-8 --no-renames --pretty=format:'user:%aN%n%ct' 1> "$GOURCE_LOG_FILE"
if [[ "$?" != "0" ]]; then
 printf "%b\n" "$KO"
 printf "Could not generate gource log file at %s\n" "$GOURCE_LOG_FILE"
 exit 1
fi
printf "%b\n" "$OK"
printf "Determining Wine Binary..."
if [[ -n "$OVERRIDE_WINE_BIN" && -x "$OVERRIDE_WINE_BIN" ]]; then
    printf "%b\n" "$OK"
    printf "Wine binary override present and callable, using it as reference\n"
    WINE_BIN=$OVERRIDE_WINE_BIN
else
    WINE_BIN=$(command -v "wine")
    if [[ "$?" != "0" ]]; then
        printf "%b\n" "$KO"
        printf "Could not locate a wine binary installation in your system\n"
        printf "Please make sure that wine is installed and available in your PATH for this script to find it\n"
        exit 1
    fi
    printf "%b\n" "$OK"
fi
printf "Setting Gource log environment variable for Wine..."
export GOURCE_LOG_FILE_WIN="$(winepath -w "$GOURCE_LOG_FILE" 2>>"$GOURCE_STANDARD_ERR" )"
if [[ "$?" != "0" ]]; then
 printf "%b\n" "$KO"
 printf "Could not convert gource log file path to Windows format\n"
 exit 1
fi
printf "%b\n" "$OK"
printf "Overriding vulkan DLL to suppress warnings..."
export WINEDLLOVERRIDES="vulkan.dll="
printf "%b\n" "$OK"
printf "Warming up...%b\n" "$OK"
printf "Starting Gource via Wine...\n"

# Change to Gource folder for proper data loading
printf "Changing to Gource directory at %s..." "$GOURCE_DIR"
cd "$GOURCE_DIR"
if [[ "$?" != "0" ]]; then
 printf "%b\n" "$KO"
 printf "Could not change to Gource directory at %s\n" "$GOURCE_DIR"
 printf "Reverting to original directory at %s\n" "$ORIG_PWD"
 cd "$ORIG_PWD"
 exit 1
fi
printf "%b\n" "$OK"
printf "Determining Gource Binary..."
if [[ -n "$OVERRIDE_GOURCE_BIN" && -x "$OVERRIDE_GOURCE_BIN" ]]; then
    printf "%b\n" "$OK"
    printf "Windows gource binary override present and callable, using it as reference\n"
    GOURCE_BIN=$OVERRIDE_GOURCE_BIN
else
    if [[ ! -x "$GOURCE_DIR/$GOURCE_BIN_NAME" ]]; then
        printf "%b\n" "$KO"
        printf "Could not locate a windows gource binary installation in your system\n"
        printf "Please make sure that $GOURCE_BIN_NAME is available in '$GOURCE_DIR' for this script to find it\n"
        exit 1
    fi
    GOURCE_BIN="$GOURCE_DIR/$GOURCE_BIN_NAME"
    printf "%b\n" "$OK"
fi
printf "Preparing Gource arguments..."
GOURCE_FLAGS=(--viewport "$SCREEN_RESOLUTION" --auto-skip-seconds 1)
if [[ -n "$SECONDS_PER_DAY" ]]; then
    GOURCE_FLAGS+=(--seconds-per-day "$SECONDS_PER_DAY")
fi
if [[ "$VIDEO_MODE" == "$TRUE" ]]; then
    GOURCE_FLAGS+=("${GOURCE_VIDEO_ARGS[@]}")
    GOURCE_FLAGS+=("--stop-at-end")
fi
printf "%b\n" "$OK"
printf "Preparing Wine arguments..."
WINE_CMD=(env "$WINE_BIN")
if [[ "$WINE_DESKTOP_ENABLED" == "$TRUE" ]]; then
    WINE_CMD+=(explorer /desktop=${WINE_DESKTOP_NAME},${WINE_DESKTOP_SIZE})
fi
WINE_CMD+=("$GOURCE_BIN" "$GOURCE_LOG_FILE_WIN")
WINE_CMD+=("${GOURCE_FLAGS[@]}")
printf "%b\n" "$OK"
printf "Calling Gource via Wine..."
if [[ "$DRY_RUN" == "$TRUE" ]]; then
    run_cmd "${WINE_CMD[@]}"
else
    run_cmd \
        "${WINE_CMD[@]}" \
        1>"$REDIRECT_FLAGS" \
        2>>"$GOURCE_STANDARD_ERR"
fi
    # --auto-skip-seconds 1 --seconds-per-day 0.1 --hide filenames,dirnames,mouse --max-files 0 --file-idle-time 0 --background-colour 000000 --font-size 18  --logo "$GOURCE_DIR/logo.png" --logo-scale 0.2 
STATUS=$?
if [[ "$STATUS" != "0" ]]; then
 printf "%b\n" "$KO"
 printf "Gource execution failed with status %d\n" "$STATUS"
 printf "Reverting to original directory at %s\n" "$ORIG_PWD"
 cd "$ORIG_PWD"
 exit $STATUS
fi
printf "%b\n" "$OK"
printf "Starting Gource via Wine...%b\n" "$OK"
if [[ "$VIDEO_MODE" == "$FALSE" ]]; then
    printf "Gource, for windows calls, status: %d" "$STATUS"
    exit $STATUS
fi

printf "Checking ffmpeg presence..."
if [[ -n "$OVERRIDE_FFMPEG_BIN" && -x "$OVERRIDE_FFMPEG_BIN" ]]; then
    printf "%b\n" "$OK"
    printf "FFmpeg binary override is present and callable, using it as reference\n"
    FFMPEG_BIN="$OVERRIDE_FFMPEG_BIN"
else
    FFMPEG_BIN=$(command -v "ffmpeg")
    if [[ "$?" != "0" ]]; then
        printf "%b\n" "$KO"
        printf "FFmpeg not found, please download ffmpeg or make sure it is available in the path"
        exit 1
    fi
fi
printf "%b\n" "$OK"
printf "Preparing FFmpeg arguments..."
FFMPEG_CMD=("$FFMPEG_BIN")
FFMPEG_CMD+=("${FFMPEG_ARGS[@]}")
printf "%b\n" "$OK"
printf "Converting gource ppm to mp4..."
if [[ "$DRY_RUN" == "$TRUE" ]]; then
    run_cmd "${FFMPEG_CMD[@]}"
else
    run_cmd "${FFMPEG_CMD[@]}" 1>>"$FFMPEG_STANDARD_OUT" 2>>"$FFMPEG_STANDARD_ERR"
fi
if [[ "$?" != "0" ]]; then
    printf "%b\n" "$KO"
    printf "Failed to convert the video"
    exit 1
fi
printf "%b\n" "$OK"

printf "Gource for windows called, status: %d\n" "$STATUS"
exit $STATUS
